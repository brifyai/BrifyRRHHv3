# Variables de entorno para Easypanel
# Estas variables cambian el puerto de analytics para evitar conflictos

# Cambiar puerto de analytics de 4000 a 54000
ANALYTICS_PORT=54000
ANALYTICS_EXTERNAL_PORT=54000

# Deshabilitar analytics si es posible
DISABLE_ANALYTICS=true
ANALYTICS_ENABLED=false

# Configuración de Supabase
SUPABASE_PUBLIC_URL=${SUPABASE_PUBLIC_URL}
SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SUPABASE_SERVICE_ROLE_KEY}

# Puerto de Kong (debe permanecer en 8000)
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# Puerto de Studio (debe permanecer en 3000)
STUDIO_PORT=3000

# Puerto de PostgreSQL
POSTGRES_PORT=5432
