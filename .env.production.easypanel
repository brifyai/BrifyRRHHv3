# Variables de entorno para Easypanel - Cambiar TODOS los puertos conflictivos
# Esto evita conflictos con servicios existentes en el servidor

# ANALYTICS - Cambiar de 4000 a 14000
ANALYTICS_PORT=14000
ANALYTICS_EXTERNAL_PORT=14000

# KONG - Cambiar de 8000 a 18000
KONG_HTTP_PORT=18000
KONG_HTTPS_PORT=18443

# STUDIO - Cambiar de 3000 a 13000  
STUDIO_PORT=13000

# POSTGRES - Mantener 5432
POSTGRES_PORT=5432

# REALTIME - Puerto interno, no cambiar
REALTIME_PORT=4000

# REST - Puerto interno
PGRST_SERVER_PORT=3000

# STORAGE - Puerto interno
STORAGE_PORT=5000

# META - Puerto interno
PG_META_PORT=8080

# Deshabilitar analytics si es posible
DISABLE_ANALYTICS=true
ANALYTICS_ENABLED=false
